# Allow only files required by a Next.js production build.
**
!app
!app/**
!components
!components/**
!lib
!lib/**
!public
!public/**
!components.json
!eslint.config.mjs
!next-env.d.ts
!next.config.ts
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!postcss.config.mjs
!tailwind.config.ts
!tsconfig.json
!Dockerfile
!.dockerignore

# These exclusions must follow the directory allowlist.
**/.env
**/.env.*
**/.venv
**/node_modules
**/.next
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.coverage*
**/htmlcov
**/test-results
**/playwright-report
**/storage
**/.git
**/secrets
**/*.pem
**/*.key
**/*.pdf
