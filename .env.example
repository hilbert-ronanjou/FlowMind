# Local PostgreSQL / Docker Compose runtime
POSTGRES_DB=flowmind
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Backend runtime
DATABASE_URL=postgresql+psycopg://flowmind:replace-with-a-local-database-password@localhost:5432/flowmind
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
APP_ENVIRONMENT=development
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=
# Interactive operation quotas (not monetary billing); runtime, restart to apply.
AI_PAID_OPERATIONS_ENABLED=true
AI_INTERACTIVE_USER_WINDOW_LIMIT=5
AI_INTERACTIVE_WINDOW_SECONDS=60
AI_INTERACTIVE_USER_DAILY_LIMIT=20
AI_INTERACTIVE_GLOBAL_DAILY_LIMIT=100
AI_EXTRACTION_MAX_INPUT_CHARS=10000
AI_RAG_MAX_PROMPT_CHARS=24000
AI_QWEN_MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL=text-embedding-v4
# Embedding dimensions are fixed at 1024 by the application/schema, not configurable.
DOCUMENT_STORAGE_ROOT=../storage/documents
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_COURSE_LIMIT=20
# PDF background admissions, independent of interactive AI quotas; UTC day.
DOCUMENT_MAX_PAGES=80
DOCUMENT_MAX_TEXT_CHARS=150000
DOCUMENT_MAX_CHUNKS=200
DOCUMENT_USER_DAILY_LIMIT=2
DOCUMENT_GLOBAL_DAILY_LIMIT=20
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=200
EMBEDDING_BATCH_SIZE=16
DOCUMENT_PROCESSING_STALE_SECONDS=1800
KNOWLEDGE_TOP_K=5

# Frontend build-time; local development calls FastAPI directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
