# Local PostgreSQL / Docker Compose runtime
POSTGRES_DB=flowmind
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Backend runtime
DATABASE_URL=postgresql+psycopg://flowmind:replace-with-a-local-database-password@localhost:5432/flowmind
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=
EMBEDDING_MODEL=text-embedding-v4
# Embedding dimensions are fixed at 1024 by the application/schema, not configurable.
DOCUMENT_STORAGE_ROOT=../storage/documents
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_COURSE_LIMIT=20
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=200
EMBEDDING_BATCH_SIZE=16
DOCUMENT_PROCESSING_STALE_SECONDS=1800
KNOWLEDGE_TOP_K=5

# Frontend build-time; local development calls FastAPI directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
