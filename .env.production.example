# Copy to .env.production (ignored by Git). Read docs/DEPLOYMENT.md first.
# Compose mounts this file read-only at /app/.env, NOT as image contents.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
FLOWMIND_IMAGE_TAG=m1-b
BACKEND_ENV_FILE=./.env.production
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt

# PostgreSQL container runtime
POSTGRES_DB=flowmind
POSTGRES_USER=flowmind
# Put the database password in POSTGRES_PASSWORD_FILE, without shell quotes.
# Use the SAME password in DATABASE_URL below; prefer a random hex password.

# Backend runtime
DATABASE_URL=postgresql+psycopg://flowmind:replace-with-a-production-database-password@postgres:5432/flowmind
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:8080
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=
EMBEDDING_MODEL=text-embedding-v4
# Embedding dimensions are fixed at 1024 by the application/schema, not configurable.
DOCUMENT_STORAGE_ROOT=/var/lib/flowmind/documents
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_COURSE_LIMIT=20
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=200
EMBEDDING_BATCH_SIZE=16
DOCUMENT_PROCESSING_STALE_SECONDS=1800
KNOWLEDGE_TOP_K=5

# Frontend build-time; public by definition and must never contain a secret.
NEXT_PUBLIC_API_URL=/api/v1
