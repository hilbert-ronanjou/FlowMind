# Example contract only. Supply real secrets at runtime; never bake them into images.

# PostgreSQL container runtime
POSTGRES_DB=flowmind
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=replace-with-a-production-database-password

# Backend runtime
DATABASE_URL=postgresql+psycopg://flowmind:replace-with-a-production-database-password@postgres:5432/flowmind
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=https://flowmind.example.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
DOCUMENT_STORAGE_ROOT=/var/lib/flowmind/documents
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_COURSE_LIMIT=20
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=200
EMBEDDING_BATCH_SIZE=16
DOCUMENT_PROCESSING_STALE_SECONDS=1800
KNOWLEDGE_TOP_K=5

# Frontend build-time; public by definition and must never contain a secret.
NEXT_PUBLIC_API_URL=/api/v1
