        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(rag_queries_total{job=\"flowmind-backend\"}[15m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "title": "RAG P95 latency",
