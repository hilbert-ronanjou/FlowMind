{
  "uid": "flowmind-overview",
  "title": "FlowMind Production Overview",
  "description": "Single-worker application metrics. Check scrape health before interpreting empty/zero traffic panels. No infrastructure or estimated usage metrics.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "flowmind"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend scrape target health",
      "type": "stat",
      "description": "1 = successful scrape, 0 = failed. No samples = target not yet observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"flowmind-backend\"}",
          "legendFormat": "Backend",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "description": "Check scrape health separately. Rates/increases handle counter resets; sparse counts are extrapolated. No latency samples is not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"flowmind-backend\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "HTTP requests per second",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx error rate (%)",
      "type": "timeseries",
      "description": "Check scrape health separately. Rates/increases handle counter resets; sparse counts are extrapolated. No latency samples is not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{job=\"flowmind-backend\",status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"flowmind-backend\"}[$__rate_interval])) or vector(0)), 1e-9)",
          "legendFormat": "HTTP 5xx error rate (%)",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP P95 latency",
      "type": "timeseries",
      "description": "Check scrape health separately. Rates/increases handle counter resets; sparse counts are extrapolated. No latency samples is not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"flowmind-backend\"}[$__rate_interval])))",
          "legendFormat": "HTTP P95 latency",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "AI provider requests (rolling 15 min)",
      "type": "timeseries",
      "description": "Check scrape health separately. Rates/increases handle counter resets; sparse counts are extrapolated. No latency samples is not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (increase(ai_requests_total{job=\"flowmind-backend\"}[15m]))",
          "legendFormat": "{{operation}} / {{outcome}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "AI provider P95 duration",
      "type": "timeseries",
      "description": "Check scrape health separately. Rates/increases handle counter resets; sparse counts are extrapolated. No latency samples is not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(ai_request_duration_seconds_bucket{job=\"flowmind-backend\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Provider-reported tokens (selected range)",
      "type": "stat",
      "description": "Actual provider-reported counters only; currently grounded-answer Qwen input/output. No embedding estimate. Missing series = not reported. increase is extrapolated, not billing evidence.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowmind-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Not reported"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, direction) (increase(ai_tokens_total{job=\"flowmind-backend\"}[$__range]))",
          "legendFormat": "{{operation}} / {{direction}}",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "RAG outcomes (rolling 15 min)",
      "type": "timeseries",
      "description": "Check scrape health separately. Rates/increases handle counter resets; sparse counts are extrapolated. No latency samples is not zero latency.",
      "datasource": {
